/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  # 一度訪れたブラウザに「このサイトは今後も必ずHTTPSで」と覚えさせる（2年）
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # 読み込んでよい先を限定し、外部から仕込まれたスクリプトが動かないようにする
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://*.googleapis.com https://*.gstatic.com https://*.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://*.google.com https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; upgrade-insecure-requests

# CSS・JSはファイル名が変わらないので、毎回サーバーに確認させる。
# 中身が同じときは 304 が返るだけなので速度はほとんど落ちない。
# （ここを長期キャッシュにすると、修正しても見た人の画面が数日変わらない）
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 画像も差し替えることがあるため1日。以降は再確認しつつ古いものを表示。
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
